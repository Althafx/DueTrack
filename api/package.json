{
  "name": "@payment-collection/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "seed": "npm run seed:generate && npm run seed:apply:local",
    "seed:generate": "tsx seed-d1.ts > .seed-data.sql",
    "seed:apply:local": "wrangler d1 execute duetrack-db --local --file=./.seed-data.sql",
    "seed:apply:remote": "wrangler d1 execute duetrack-db --remote --file=./.seed-data.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:local": "wrangler d1 migrations apply duetrack-db --local",
    "migrate:remote": "wrangler d1 migrations apply duetrack-db --remote"
  },
  "dependencies": {
    "@payment-collection/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.130.0"
  }
}
