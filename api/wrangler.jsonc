{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duetrack-api",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "index.ts",

  // `iconv-lite` is pulled in transitively via express -> body-parser ->
  // raw-body. The real iconv-lite crashes at import time under Workers,
  // so it is aliased to a harmless stub.
  "alias": {
    "iconv-lite": "./stubs/iconv-lite.js"
  },

  // Non-secret config. Declaring these here (rather than only in the
  // Cloudflare dashboard) means `wrangler deploy` won't wipe them on future
  // deploys — plain dashboard vars not listed in this file get deleted on
  // deploy unless `keep_vars: true` is set. JWT_SECRET and
  // PASSWORD_ENCRYPTION_KEY are real secrets and are NOT declared here —
  // they're set via `wrangler secret put`, which deploy never touches.
  "vars": {
    "CLIENT_ORIGIN": "https://duetrack.engine-core.workers.dev",
    "NODE_ENV": "production",
    "JWT_EXPIRES_IN": "7d"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duetrack-db",
      "database_id": "722a1997-d9d9-45dc-bbb6-ba01dfb0da75"
    }
  ]
}