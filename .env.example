MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/payment-collection-system?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# 32-byte key as 64 hex chars, generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENCRYPTION_KEY=replace-with-a-64-character-hex-string
NODE_ENV=development
PORT=5000
